# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Adapter Node request-body limit. This allows a 5 MB image plus multipart overhead.
BODY_SIZE_LIMIT=6M

# Better Auth
# Use at least 32 high-entropy characters in every environment.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Account created by npm run db:seed (never use these placeholder values in production)
ADMIN_NAME="Administrator Ar-Rahmah"
# Username untuk login dashboard. Email tetap disimpan internal oleh Better Auth.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-16-character-password"
